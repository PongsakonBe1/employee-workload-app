rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A user profile's document ID identifies its Firebase Auth UID. Legacy
    // profiles may omit the duplicate uid field. Role and active are authority
    // fields, and pendingUsers is a request rather than an access grant.
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function verifiedEmail() {
      return isAuthenticated() && request.auth.token.get('email_verified', false) == true &&
        request.auth.token.get('email', null) is string;
    }

    function hasActiveRole(roles) {
      return verifiedEmail() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        profileGrantsRole(get(/databases/$(database)/documents/users/$(request.auth.uid)).data, roles);
    }

    function profileGrantsRole(profile, roles) {
      return profile.get('active', false) == true && profile.get('role', '') in roles &&
        (profile.role != 'superadmin' || profile.get('email', null) == request.auth.token.email);
    }

    function isAdmin() {
      return hasActiveRole(['admin', 'superadmin']);
    }
    
    function isSuperAdmin() {
      return hasActiveRole(['superadmin']);
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isStaff() {
      return hasActiveRole(['staff']);
    }

    function isValidUser(data, userId) {
      return data.email is string && data.email.size() <= 254 &&
        data.email.matches('^[^@ ]+@[^@ ]+$') &&
        data.role in ['staff', 'admin', 'superadmin'] && data.active is bool &&
        data.get('uid', userId) == userId;
    }

    function isAllowedBootstrap(data) {
      return data.role == 'superadmin' && !('migratedFrom' in data) &&
        request.auth.token.email in ['pongsagon.be1@gmail.com', 'pongsakon.be1@gmail.com'];
    }

    function isApprovedMigration(data, userId) {
      let legacy = data.get('migratedFrom', '');
      return legacy is string && legacy.matches('^[a-zA-Z0-9_-]{1,128}$') && legacy != userId &&
        exists(/databases/$(database)/documents/users/$(legacy)) &&
        sameProfileAuthority(get(/databases/$(database)/documents/users/$(legacy)).data, data);
    }

    function sameProfileAuthority(original, candidate) {
      return original.get('active', false) == true && original.get('email', null) == request.auth.token.email &&
        original.get('role', '') == candidate.role;
    }
    
    function isWorkLogOwner(worklog) {
      return isAuthenticated() && 
        (worklog.employeeId == request.auth.uid || 
         worklog.createdBy == request.auth.uid);
    }
    
    function isNotLocked(worklog) {
      return worklog.locked != true;
    }
    
    function isValidWorkLog() {
      return request.resource.data.keys().hasAll(['date', 'time', 'minorTask', 'mainDuty']) &&
             request.resource.data.date is string &&
             request.resource.data.time is string &&
             request.resource.data.minorTask is string &&
             request.resource.data.mainDuty is string;
    }

    function isValidWorkLogUpdate() {
      // Update ไม่จำเป็นต้องส่งทุกฟิลด์ — ตรวจเฉพาะฟิลด์ที่ส่งมาว่าถูกชนิด
      // SA Note: v2.3.0-replan — เพิ่ม equipmentCondition/equipmentNote (ITEM-1)
      let hasDate = request.resource.data.keys().hasAny(['date']);
      let hasTime = request.resource.data.keys().hasAny(['time']);
      let hasEquipmentCondition = request.resource.data.keys().hasAny(['equipmentCondition']);
      let hasEquipmentNote = request.resource.data.keys().hasAny(['equipmentNote']);
      let validDate = !hasDate || (request.resource.data.date is string);
      let validTime = !hasTime || (request.resource.data.time is string);
      let validEquipmentCondition = !hasEquipmentCondition || (request.resource.data.equipmentCondition in ['normal', 'damaged', 'lost']);
      let validEquipmentNote = !hasEquipmentNote || (request.resource.data.equipmentNote is string);
      return validDate && validTime && validEquipmentCondition && validEquipmentNote;
    }

    function isSameDay(worklog) {
      // ตรวจสอบว่า worklog ถูกสร้างภายใน 24 ชั่วโมงที่ผ่านมา
      // (ครอบคลุม timezone UTC+7 โดยไม่ต้องคำนวณ offset)
      let cutoff = request.time - duration.value(24, 'h');
      return worklog.createdAt > cutoff;
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      // First sign-in can look up only the verified email; active users retain
      // access to the team directory used by existing screens.
      allow read: if hasActiveRole(['staff', 'admin', 'superadmin']) ||
        (verifiedEmail() && resource.data.email == request.auth.token.email);

      allow create: if isValidUser(request.resource.data, userId) &&
        ((isOwner(userId) && verifiedEmail() &&
          request.resource.data.email == request.auth.token.email && request.resource.data.active == true &&
          (isAllowedBootstrap(request.resource.data) || isApprovedMigration(request.resource.data, userId))) ||
         (isAdmin() && request.resource.data.role in ['admin', 'staff']));

      allow delete: if isSuperAdmin();
      allow update: if isValidUser(request.resource.data, userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'email']) &&
        (isSuperAdmin() ||
         (isAdmin() && request.resource.data.role in ['admin', 'staff'] &&
          (resource.data.role == 'staff' || (isOwner(userId) && resource.data.role == 'admin'))) ||
         (isOwner(userId) && verifiedEmail() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname', 'fullName', 'lastLoginAt', 'fcmToken'])));
    }

    // Worklogs collection
    match /worklogs/{worklogId} {
      // Read: All authenticated users (filter at client level)
      // Temporary fix: isAdmin() causes circular dependency issues
      allow read: if isAuthenticated();
      
      // Create: Staff can only create their own worklog, Admin can create for anyone
      allow create: if isAuthenticated() && isValidWorkLog() &&
        (request.resource.data.employeeId == request.auth.uid || isAdmin());
      
      // Update: Admin anytime (with validation), staff/owner only if not locked
      // Note: same-day enforcement is handled client-side via canEdit() lockTime check
      allow update: if (isAdmin() && isValidWorkLogUpdate()) ||
        (isAuthenticated() &&
         (resource.data.employeeId == request.auth.uid || resource.data.get('createdBy', '') == request.auth.uid) &&
         resource.data.get('locked', false) != true &&
         isValidWorkLogUpdate());
      
      // Delete: Admin anytime, staff/owner only if not locked
      // Note: same-day enforcement is handled client-side via canEdit() lockTime check
      allow delete: if isAdmin() ||
         (isAuthenticated() && 
          (resource.data.employeeId == request.auth.uid || resource.data.get('createdBy', '') == request.auth.uid) &&
          resource.data.get('locked', false) != true);
    }

    // Audit logs collection
    match /auditLogs/{logId} {
      // Only admin can read audit logs
      allow read: if isAdmin();
      
      // System only (via Cloud Functions)
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Categories collection (read-only for users)
    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Settings collection (admin only)
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Pending users collection (for approval system)
    match /pendingUsers/{userId} {
      allow get: if isOwner(userId) && verifiedEmail();
      allow read: if isAdmin();
      
      // Authenticated users can create their own pending request
      allow create: if isOwner(userId) && verifiedEmail() &&
        request.resource.data.uid == userId && request.resource.data.status == 'pending' &&
        request.resource.data.email == request.auth.token.email &&
        request.auth.token.email.matches('^[^@ ]+@icit\\.kmutnb\\.ac\\.th$');
      
      // Admin can delete (approve/reject)
      allow delete: if isAdmin();
      
      // No updates allowed
      allow update: if false;
    }

    // Notifications collection
    match /notifications/{notificationId} {
      // get: Users can read their own notifications + broadcast to all + role-based
      allow get: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || 
         resource.data.userId == "all" ||
         resource.data.userId == "staff" && isStaff() ||
         resource.data.userId == "admin" && isAdmin() ||
         resource.data.userId == "superadmin" && isSuperAdmin());
      
      // list: Allow all authenticated to list (filter at client side for quota optimization)
      allow list: if isAuthenticated();
      
      // System/Admin/Superadmin can create notifications, or users creating personal notifications
      allow create: if isAuthenticated() && (isAdmin() || request.resource.data.userId == request.auth.uid);
      
      // Users can update (mark as read) their own + broadcast + role-based notifications
      allow update: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || 
         resource.data.userId == "all" ||
         (resource.data.userId == "staff" && isStaff()) ||
         (resource.data.userId == "admin" && isAdmin()) ||
         isSuperAdmin()) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt', 'readBy']);
      
      // Users can delete their own + broadcast + role-based notifications, superadmin can delete any
      allow delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || 
         resource.data.userId == "all" ||
         (resource.data.userId == "staff" && isStaff()) ||
         (resource.data.userId == "admin" && isAdmin()) ||
         isSuperAdmin());
    }

    // Admin Promotion Requests collection
    match /adminPromotionRequests/{requestId} {
      // Superadmin can read all requests
      // Admin can read their own requests
      allow read: if isAuthenticated() && 
        (isSuperAdmin() || resource.data.requestedBy == request.auth.uid);
      
      // Admin can create requests
      allow create: if isAuthenticated() && 
        isAdmin() && 
        request.resource.data.requestedBy == request.auth.uid &&
        request.resource.data.status == 'pending';
      
      // Superadmin can update (approve/reject) requests
      allow update: if isAuthenticated() && 
        isSuperAdmin() &&
        request.resource.data.status in ['approved', 'rejected'];
      
      // Superadmin can delete requests
      allow delete: if isAuthenticated() && isSuperAdmin();
    }

    // Export Requests collection (for staff export approval workflow)
    match /exportRequests/{requestId} {
      // Staff can read their own requests (check resource.data for single doc)
      // Admin/Superadmin can read all requests
      // Note: For list queries, staff must filter client-side
      allow get: if isAuthenticated() && 
        (resource.data.staffId == request.auth.uid || isAdmin());
      
      // Staff can list all but will filter client-side (simpler for rules)
      // Alternative: Only allow admin to list, staff must use specific doc ID
      allow list: if isAuthenticated() && isAdmin();
      
      // Staff can create their own requests (simplified - trust client)
      allow create: if isAuthenticated();
      
      // Admin/Superadmin can update (approve/reject) any request
      allow update: if isAuthenticated() && 
        isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedAt', 'approvedBy', 'approvedByName', 'rejectedAt', 'rejectedBy', 'rejectedByName']);
      
      // Admin/Superadmin can delete requests
      allow delete: if isAuthenticated() && isAdmin();
    }

    // System Logs collection (for superadmin audit)
    match /systemLogs/{logId} {
      // Only superadmin can read system logs
      allow read: if isSuperAdmin();
      
      // Any authenticated user can create logs (needed for login/logout events)
      allow create: if isAuthenticated();
      
      // No updates/deletes
      allow update, delete: if false;
    }

    // Global Templates collection (Quick Log Templates)
    match /globalTemplates/{templateId} {
      // All authenticated users can read templates
      allow read: if isAuthenticated();
      
      // Admin and superadmin can create templates
      allow create: if isAdmin() && 
        request.resource.data.keys().hasAll(['name', 'minorTask', 'mainDuty']) &&
        request.resource.data.name is string &&
        request.resource.data.minorTask is string &&
        request.resource.data.mainDuty is string;
      
      // Admin can update all fields; authenticated users can only update usage stats
      allow update: if isAdmin() ||
        (isAuthenticated() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount', 'lastUsedAt']));
      
      // Admin and superadmin can delete templates
      allow delete: if isAdmin();
    }

    // RoomEquipmentStatus collection (for tracking room and equipment status)
    match /RoomEquipmentStatus/{statusId} {
      // All authenticated users can read status
      allow read: if isAuthenticated();
      
      // Staff and admin can update status (for borrowing/returning equipment, opening/closing rooms)
      allow update: if isAuthenticated() && (isStaff() || isAdmin());
      
      // Only admin can create/delete status documents
      allow create, delete: if isAdmin();
    }

    // Classroom Schedules collection (Floor 4 class schedules)
    match /classroomSchedules/{scheduleId} {
      // All authenticated users can read schedules
      allow read: if isAuthenticated();
      
      // Only admin can create/update/delete schedules
      allow create, update, delete: if isAdmin();
    }

    // DL Exam Schedules collection (Digital Literacy exam schedules)
    match /dlExamSchedules/{scheduleId} {
      // All authenticated users can read exam schedules
      allow read: if isAuthenticated();
      
      // Only admin can create/update/delete exam schedules
      allow create, update, delete: if isAdmin();
    }

    // Equipment Items collection (admin-managed equipment inventory)
    // Schema: { name, minorTask, location, active, order, createdAt, updatedAt, createdBy }
    match /equipmentItems/{itemId} {
      // All authenticated users can read (staff needs active items for comment suggestions)
      allow read: if isAuthenticated();
      
      // Only admin can create equipment items
      allow create: if isAdmin() &&
        request.resource.data.keys().hasAll(['name', 'minorTask', 'active']) &&
        request.resource.data.name is string &&
        request.resource.data.minorTask is string &&
        request.resource.data.active is bool;
      
      // Only admin can update equipment items
      allow update: if isAdmin();
      
      // Only admin can delete equipment items
      allow delete: if isAdmin();
    }
  }
}
